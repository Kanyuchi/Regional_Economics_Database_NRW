# Environment Variables for Regional Economics Database
# Copy this file to .env and fill in your actual values

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
PG_POSTGRES_HOST=localhost
PG_POSTGRES_PORT=5432
PG_POSTGRES_USER=your_db_user
PG_POSTGRES_PASS=your_db_password

# ============================================================================
# Data Source: Regional Database Germany (Regionalstatistik)
# ============================================================================
Regionalstatistik_base_url=https://www.regionalstatistik.de/genesis/online
REGIONAL_DB_USERNAME=your_username
REGIONAL_DB_PASSWORD=your_password

# ============================================================================
# Data Source: State Database NRW (Landesdatenbank NRW)
# ============================================================================
LANDESDATENBANK_BASE_URL=https://www.landesdatenbank.nrw.de/ldbnrwws/rest/2020
LANDESDATENBANK_USER=your_username
LANDESDATENBANK_PASS=your_password

# ============================================================================
# ICT Indicators Pipeline Configuration
# ============================================================================
# Table ID for ICT indicators
ICT_TABLE_ID=52911-01i

# Year range for ICT data extraction
ICT_START_YEAR=2020
ICT_END_YEAR=2025

# Base indicator ID for ICT metrics in dim_indicator table
ICT_INDICATOR_ID_BASE=50

# Database table name for ICT fact data
ICT_FACT_TABLE=fact_ict_indicators

# ============================================================================
# ETL Pipeline Settings
# ============================================================================
# Maximum retry attempts for API requests
ETL_MAX_RETRIES=3

# Delay between retries (seconds)
ETL_RETRY_DELAY=5

# Request timeout (seconds)
ETL_REQUEST_TIMEOUT=120

# Batch size for data processing
ETL_BATCH_SIZE=100

# Enable verbose logging (true/false)
ETL_VERBOSE_LOGGING=true

# Save raw data for inspection (true/false)
ETL_SAVE_RAW_DATA=true

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory (relative to project root)
LOG_DIR=logs

# ============================================================================
# Testing Configuration
# ============================================================================
# Use test database for pytest
TEST_DATABASE=regional_db_test

# Mock API responses in tests (true/false)
TEST_MOCK_API=true
