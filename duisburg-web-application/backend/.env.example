# Backend Production Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=your-postgres-host.com
DB_PORT=5432
DB_NAME=regional_db
DB_USER=your-db-username
DB_PASSWORD=your-secure-password

# SSL Configuration (required for hosted databases like Render PostgreSQL)
DB_SSL=true
# OR use:
# PGSSLMODE=require

# Server Configuration
# Note: Render will override this with its own dynamic PORT
PORT=3001
HOST=0.0.0.0

# OpenAI Configuration (Optional - for chatbot)
OPENAI_API_KEY=sk-proj-...your-key-here
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration (Optional - comma-separated list of allowed origins)
# Example: https://duisburg-dashboard.vercel.app,https://yourdomain.com
CORS_ORIGINS=
